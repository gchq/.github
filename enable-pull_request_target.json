{
  "id": 8310,
  "name": "enable-pull_request_target",
  "target": "actions",
  "source_type": "Repository",
  "source": "gchq",
  "enforcement": "active",
  "conditions": {
    "workflow_path": {
      "exclude": [],
      "include": [
        ".github/workflows/auto-reject-untrusted-pr.yml"
      ]
    }
  },
  "rules": [
    {
      "type": "restrict_action_events",
      "parameters": {
        "allowed_events": [
          "pull_request_target"
        ]
      }
    }
  ],
  "bypass_actors": []
}